# =================================================================
# RoleForge – Environment Configuration
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local)
# If left empty in development, RoleForge automatically starts an embedded
# in-memory MongoDB engine for zero-dependency instant development!
MONGODB_URI=mongodb://127.0.0.1:27017/roleforge

# JWT Authentication
JWT_SECRET=roleforge-super-secure-jwt-secret-key-change-in-prod-2025
JWT_EXPIRES_IN=7d

# Optional Cloud AI Intelligence (Gemini or OpenAI)
# If left empty, RoleForge operates with its built-in Semantic Heuristic Engine
# ensuring 100% uptime, zero hallucinations, and zero training data leaks.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Google OAuth 2.0
GOOGLE_CLIENT_ID=

# Optional Cloudinary Storage (For uploaded document archives)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

