# =================================================================
# RoleForge – Environment Configuration
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local)
# If left empty in development, RoleForge automatically starts an embedded
# in-memory MongoDB engine for zero-dependency instant development!
MONGODB_URI=

# JWT Authentication
JWT_SECRET=roleforge-super-secure-jwt-secret-key-change-in-prod-2025
JWT_EXPIRES_IN=7d

# Optional Cloud AI Intelligence (Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Google OAuth & Cloudinary
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Client Configuration (Place in .env or client/.env.local)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
